# ============================================================
#  MONEY MACHINE — .env Template
#  Copy karo: cp env.example .env
#  Phir apni values bharo
# ============================================================

# ── Database (Required) ──────────────────────────────────────
DATABASE_URL=postgresql://mmuser:YOURPASSWORD@localhost:5432/moneymachine

# ── Auth (Required — bina in ke login nahi hoga) ─────────────
FAST2SMS_API_KEY=your_fast2sms_api_key
REGISTERED_PHONE=9876543210
SESSION_SECRET=koi_bhi_random_64_char_string_yahan_likhein

# ── Telegram Alerts (Optional) ───────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-your-token
TELEGRAM_CHAT_ID=your_chat_id

# ── Binance (Optional) ───────────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Bybit (Optional) ─────────────────────────────────────────
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ── Bitget (Optional) ────────────────────────────────────────
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# ── KuCoin (Optional) ────────────────────────────────────────
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=

# ── CoinSwitch (Optional) ────────────────────────────────────
COINSWITCH_API_KEY=
COINSWITCH_API_SECRET=

# ── Server ───────────────────────────────────────────────────
PORT=8080
NODE_ENV=production

# ── AI Market Intelligence (Ollama) ──────────────────────────
# Ollama VPS par install hota hai — same server pe chale to:
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
